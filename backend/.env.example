APP_NAME=NoorOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./nooros.db
JWT_SECRET_KEY=replace-with-a-secure-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIRECTORY=storage/uploads
MAX_UPLOAD_SIZE_MB=20
ALLOWED_DOCUMENT_CONTENT_TYPES=application/pdf